# Namuna. Nusxa oling: cp .env.example .env.local
#
# API manzili. Dev'da "/api" qoldiring (proxy ishlatiladi),
# prod'da to'liq https manzil yozing.
REACT_APP_API_URL=/api

# Dev proxy target (faqat `npm start` uchun)
REACT_APP_API_PROXY_TARGET=http://crm.gennis.uz

# Qo'ng'iroq hodisalari fallback polling oralig'i (ms). SSE ishlasa ishlatilmaydi.
REACT_APP_CALL_POLL_INTERVAL=4000
